{
  "appId": "dev.wkmcode.painelping",
  "productName": "Painel Ping",
  "electronVersion": "44.5.1",
  "directories": {
    "output": "../../desktop-release"
  },
  "files": [
    "desktop/**/*",
    "backend/dist/**/*",
    "backend/package.json",
    "frontend/dist/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "asar": true,
  "win": {
    "target": ["nsis"],
    "artifactName": "Painel-Ping-${version}-Windows-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Network",
    "artifactName": "Painel-Ping-${version}-Linux-${arch}.${ext}",
    "maintainer": "WKMcode-dev"
  }
}
