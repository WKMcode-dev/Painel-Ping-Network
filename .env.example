# Copie este arquivo para .env quando quiser alterar os valores padrão.
PORT=3333
PING_INTERVAL_MS=5000
PING_TIMEOUT_MS=1500
FAILURE_THRESHOLD=2
HISTORY_LIMIT=120
DATA_RETENTION_DAYS=30
ALLOWED_ORIGINS=http://localhost:5173


MAX_CONCURRENT_PINGS=8

# Dados ficam fora da pasta do projeto (Windows: %LOCALAPPDATA%\PainelPing\data).
# Opcional: caminho ABSOLUTO fixo para serviço, servidor ou armazenamento compartilhado.
# DATA_DIR=C:\PainelPingDados
# Primeira migração: use se a versão antiga estiver longe ou houver várias origens.
# LEGACY_DATA_DIR=C:\Users\SeuUsuario\Desktop\Painel-Ping-v1.9.0\backend\storage

# Acesso de escrita: opcional, 32–512 caracteres ASCII imprimíveis sem espaços.
# Sem esta variável, a chave é gerada na pasta fixa e mostrada uma vez no terminal.
# ADMIN_TOKEN=
# Use HTTPS/rede autorizada para acesso administrativo pela rede.

# SNMP: perfis privados do coletor; cadastre apenas o identificador REDE na interface.
# SNMPv3 authPriv com SHA-256 (ou sha) e AES-128. Substitua as duas senhas.
# SNMP_PROFILE_REDE='{"version":"3","username":"monitor","authPassword":"ALTERE_A_SENHA","privPassword":"ALTERE_A_SENHA","authProtocol":"sha256"}'
# Compatibilidade com equipamentos que oferecem apenas SNMPv2c:
# SNMP_PROFILE_LEGADO='{"version":"2c","community":"ALTERE_A_COMUNIDADE"}'
# BIND_ADDRESS=0.0.0.0
