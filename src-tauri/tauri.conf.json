{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Painel Ping",
  "version": "1.12.0",
  "identifier": "dev.wkmcode.painelping",
  "build": {
    "frontendDist": "../desktop/ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "category": "Utility",
    "shortDescription": "Monitoramento ICMP, servi\u00e7os e SNMP",
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
