{
  "name": "painel-ping",
  "version": "1.11.1",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n FRONTEND,BACKEND -c cyan,magenta \"npm run dev:frontend -w backend\" \"npm run dev -w backend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "format": "prettier --write frontend/src backend/src scripts/*.ts",
    "format:check": "prettier --check frontend/src backend/src scripts/*.ts",
    "desktop:stage": "npm run build && node desktop/stage.mjs",
    "desktop:dev": "npm run desktop:stage && electron desktop/staging",
    "desktop:package": "npm run desktop:stage && electron-builder --projectDir desktop/staging --config ../builder.json",
    "desktop:smoke": "electron desktop/staging --smoke-test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "global-agent": "4.1.3"
  }
}
